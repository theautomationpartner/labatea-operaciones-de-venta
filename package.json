{
  "name": "operaciones-de-venta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monday Vibe app · Operaciones de venta (Presupuestar / Cargar venta) — prototipo",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:credito": "esbuild tests/credito.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/credito.test.mjs && node node_modules/.cache/credito.test.mjs",
    "test:deuda": "esbuild tests/deuda.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/deuda.test.mjs && node node_modules/.cache/deuda.test.mjs",
    "test:cierre-modal": "esbuild tests/cierre-modal.test.tsx --bundle --platform=node --format=cjs --tsconfig=tsconfig.json --define:import.meta.env.DEV=false --define:import.meta.env.VITE_MONDAY_TOKEN=undefined --outfile=node_modules/.cache/cierre-modal.test.cjs && node node_modules/.cache/cierre-modal.test.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
