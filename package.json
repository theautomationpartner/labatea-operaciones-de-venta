{
  "name": "operaciones-de-venta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monday Vibe app · Operaciones de venta (Presupuestar / Cargar venta) — prototipo",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:credito": "esbuild tests/credito.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/credito.test.mjs && node node_modules/.cache/credito.test.mjs",
    "test:deuda": "esbuild tests/deuda.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/deuda.test.mjs && node node_modules/.cache/deuda.test.mjs",
    "test:busqueda": "esbuild tests/busqueda-productos.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --define:import.meta.env.DEV=false --define:import.meta.env.VITE_MONDAY_TOKEN=undefined --outfile=node_modules/.cache/busqueda.test.mjs && node node_modules/.cache/busqueda.test.mjs",
    "test:resultados": "esbuild tests/resultados-busqueda.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/resultados.test.mjs && node node_modules/.cache/resultados.test.mjs",
    "test:descuentos": "esbuild tests/descuentos.test.tsx --bundle --platform=node --format=cjs --tsconfig=tsconfig.json --define:import.meta.env.DEV=false --define:import.meta.env.VITE_MONDAY_TOKEN=undefined --outfile=node_modules/.cache/descuentos.test.cjs && node node_modules/.cache/descuentos.test.cjs",
    "test:config-descuentos": "esbuild tests/config-descuentos.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/config-descuentos.test.mjs && node node_modules/.cache/config-descuentos.test.mjs",
