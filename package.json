    "test:factura-card": "esbuild tests/factura-card.test.tsx --bundle --platform=node --format=cjs --tsconfig=tsconfig.json --define:import.meta.env.DEV=false --define:import.meta.env.VITE_MONDAY_TOKEN=undefined --outfile=node_modules/.cache/factura-card.test.cjs && node node_modules/.cache/factura-card.test.cjs",
