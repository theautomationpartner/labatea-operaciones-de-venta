    "test:comisiones": "esbuild tests/comisiones.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/comisiones.test.mjs && node node_modules/.cache/comisiones.test.mjs",
