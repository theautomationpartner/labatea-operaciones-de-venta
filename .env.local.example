# Copiá este archivo a `.env.local` y pegá un token de API de Monday para probar contra la
# cuenta real desde localhost (Monday → Avatar → Developers → My Access Tokens).
# Sin este token, la app usa los datos mock de src/data/mock.ts y funciona igual.
# En una Vibe publicada NO hace falta: el SDK usa el sessionToken del iframe de Monday.
VITE_MONDAY_TOKEN=

# Webhook del escenario de Make que lee los comprobantes de cobro (Make → escenario → módulo Webhook
# → Copiar dirección). SIN prefijo VITE_ a propósito: así la dirección se queda del lado del servidor
# y no viaja en el bundle. En desarrollo la usa el proxy de Vite; en producción,
# `api/make-comprobantes.ts`. Hay que cargarla igual en las variables de entorno del deploy.
# Sin esto, la lectura automática del comprobante falla; la carga manual del cobro funciona igual.
MAKE_WEBHOOK_COMPROBANTES=

# ───────────────────────── Capa 2 · autenticación y lista blanca ─────────────────────────
# Todas SIN prefijo VITE_ a propósito: viven en el servidor y no tienen que llegar al bundle.
# Se cargan en Vercel (Project → Settings → Environment Variables). En localhost no hacen falta:
# ahí no hay funciones serverless ni iframe de Monday, y la app pega derecho por el proxy de Vite.

# Secreto con el que Monday firma el session token del usuario. Sale de monday.com → Developers →
# tu app → Basic Information → "Signing Secret". Es LO QUE prueba que el token no lo inventó
# nadie: sin esto configurado, el backend rechaza todo (cerrado por defecto, ver api/_guard.ts).
MONDAY_SIGNING_SECRET=

# Segunda clave, del mismo lugar ("Client Secret"). Monday documenta el Signing Secret como la
# clave del session token, pero según el tipo y la versión de la app manda uno firmado con el
# Client Secret. El guárdian prueba primero el Signing y, si no cierra, reintenta con este.
# Cargar las dos evita un 401 sistémico que desde afuera parece "la app no anda".
MONDAY_CLIENT_SECRET=

# Token de API con permiso de LECTURA sobre el tablero de la lista blanca. Puede ser el mismo
# MONDAY_TOKEN que usa el proxy en producción —si no se define, se usa ese—, pero conviene uno
# propio y de solo lectura: así la consulta que decide quién entra no lleva permisos de escritura.
MONDAY_API_TOKEN=

# Tablero PRIVADO donde está la lista de usuarios habilitados (board "Lista Blanca").
WHITELIST_BOARD_ID=18427866249

# Opcionales: sólo si el tablero se rearma con otras columnas o etiquetas.
# WHITELIST_COLUMN_USER=text_mm6hqsmt      # columna de texto con el User ID de Monday
# WHITELIST_COLUMN_STATUS=status           # columna de estado que habilita o revoca
# WHITELIST_STATUS_ACTIVO=Activo           # la etiqueta que habilita; cualquier otra deja afuera

# Opcional pero recomendado: ata la app a UNA cuenta de Monday. Sin esto, un token firmado por
# Monday para otra cuenta que instale la app también llega al guardián (y ahí lo frena la lista
# blanca, pero es una puerta menos que cerrar). La cuenta de La Batea es 35883216.
# MONDAY_ACCOUNT_ID=35883216

# ───────────────────────── Capa 3 · segundo factor (TOTP) ─────────────────────────
# También del lado del servidor. En localhost no hacen falta: los endpoints de /api/mfa no corren.

# Base de datos donde viven los secretos TOTP, los códigos de recuperación y los dispositivos
# confiables. Neon o Supabase, las dos son Postgres. Tiene que ser la cadena CON POOLER (Supabase,
# puerto 6543; Neon, el host `-pooler`): contra el puerto directo, un pico de tráfico agota las
# conexiones de la base. El esquema se aplica con `psql "$DATABASE_URL" -f db/mfa.sql`.
DATABASE_URL=

# Clave de 32 bytes (base64 o hex) con la que se cifran los secretos TOTP y se hashean los códigos
# de recuperación y los tokens de dispositivo. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, se pierden TODOS los enrolamientos y hay que volver a enrolar a todo el mundo.
MFA_ENCRYPTION_KEY=

# El interruptor de la Capa 3. Con `1` el guardián exige segundo factor en todos los endpoints de
# datos. Dejarlo apagado hasta que existan las pantallas de enrolamiento: encenderlo antes deja a
# todo el mundo afuera, porque nadie puede enrolarse desde una app a la que no puede entrar.
# MFA_REQUERIDO=1

# Nombre que muestra Google Authenticator en su lista. Por defecto, "La Batea".
# MFA_EMISOR=La Batea
